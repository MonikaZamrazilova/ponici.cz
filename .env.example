# ─── Ponici.cz web — produkční konfigurace ───
# Kopírovat do .env (Vercel: Environment Variables v projektu).

# Cíl proxy adminu (/admin, /login, /api/*, /_next/* se předávají sem).
# Lokálně: http://localhost:3101 (admin se sám nastartuje).
# V produkci: https://ponici-admin.onrender.com (admin běží na vlastním serveru).
ADMIN_TARGET=

# Jak dlouho (ms) čeká proxy na remote admin (studený start Renderu),
# než vrátí 503. Výchozí 10000 (10 s) — Vercel serverless nesmí blokovat.
# Konfigurovatelné, clamp 1–60 s.
# ADMIN_REMOTE_WAIT_MS=10000

# LEGACY — nepoužívá se k žádnému přesměrování (admin fallback vrací 503
# na stejné doméně, nikdy nemění URL). Nechte prázdné.
# ADMIN_URL=

# Adresář admin aplikace pro lazy start (jen lokálně; na Vercel nevyplňovat).
# ADMIN_APP_DIR=
