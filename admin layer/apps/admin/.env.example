# Admin Layer — konfigurace aplikace admin
# Admin je zapnutý, pokud je nastaveno alespoň jedno heslo rolí.
#
# Produkce (Vercel): proměnné se nastavují v dashboardu Vercelu —
# nikdy nejsou v gitu (env jsou server-only).

# Role Admin (Owner/Admin) — všechna oprávnění.
# Session HMAC klíč je odvozený z hesla (změna hesla = revokace session).
ADMIN_PASSWORD=

# Volitelné role:
# Editor — obsah (create/update/delete/publish) + media + audit.
ADMIN_EDITOR_PASSWORD=
# Viewer — read-only (čtení obsahu, media, auditu).
ADMIN_VIEWER_PASSWORD=

# ─── Storage: GitHub (obsah + audit) ───
# GitHub Contents API — token s právy Contents read+write (fine-grained).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Větev (default main).
GITHUB_BRANCH=main
# Kořen projektů v repu (default admin layer/content/projects).
# GITHUB_CONTENT_ROOT=admin layer/content/projects
# Cesta auditu v repu (default admin layer/content/audit/central.jsonl).
# GITHUB_AUDIT_PATH=admin layer/content/audit/central.jsonl

# ─── Storage: Media (Vercel Blob) ───
# Vercel Blob Store read-write token (dashboard → Storage → Blob).
BLOB_READ_WRITE_TOKEN=

# ─── Password recovery (Vercel-native, žádný storage) ───
# E-mail majitele — jediný příjemce reset kódů. Bez něj je reset vypnutý.
ADMIN_EMAIL=
# Web3Forms access key — e-mail delivery (bez SMTP).
# Bez klíče běží MOCK režim (kód jen do logu).
WEB3FORMS_ACCESS_KEY=
# HMAC klíč pro reset/verified tokeny. Production povinný,
# dev fallback: derivace z ADMIN_PASSWORD.
# RESET_TOKEN_SECRET=

# ─── Vercel API (trvalá změna ADMIN_PASSWORD po resetu) ───
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Aktivní projekty (id z registry.ts, čárkami). Prázdné = všechny registrované.
ADMIN_PROJECTS=demo-web,sandbox,ponycedecka,ponici

# Zapnuté core moduly (čárkami). Výchozí: všechny.
# ADMIN_MODULES=dashboard,content,media,audit,settings

# TTL session v ms (výchozí 7 dní).
# ADMIN_SESSION_TTL_MS=604800000

# Volitelné deploy webhooky per projekt (JSON): {"demo-web": "https://…"}
# Volá se POST po každém publishi daného projektu.
ADMIN_PROJECT_HOOK_URLS=

# URL webu pro položku „Vstup do edit web" (single-origin = /, jinak plná URL)
ADMIN_WEB_URL=

# ===== Password reset (Web3Forms) =====
# Veřejný klíč z web3forms.com — odeslání reset kódu e-mailem (server-only)
WEB3FORMS_ACCESS_KEY=

# E-mail majitele — jediný příjemce reset kódu (ADMIN_RESET_EMAILS se nepoužívá)
ADMIN_EMAIL=

# ===== Session / reset hardening (volitelné) =====
# Dodatečný HMAC secret pro reset tokeny (bez něj se derivuje z ADMIN_PASSWORD)
RESET_TOKEN_SECRET=

# TTL session cookie v ms (výchozí 7 dní = 604800000)
ADMIN_SESSION_TTL_MS=

# ===== Vercel API (trvalá změna hesla přes env update, volitelné) =====
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# jen pro týmové projekty
VERCEL_TEAM_ID=
