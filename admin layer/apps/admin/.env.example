# Admin Layer — konfigurace aplikace admin
# Admin je zapnutý, pokud je nastaveno alespoň jedno heslo rolí.

# Role Admin (Owner/Admin) — všechna oprávnění.
ADMIN_PASSWORD=

# Volitelné role:
# Editor — obsah (create/update/delete/publish) + media + audit.
ADMIN_EDITOR_PASSWORD=
# Viewer — read-only (čtení obsahu, media, auditu).
ADMIN_VIEWER_PASSWORD=

# Aktivní projekty (id z registry.ts, čárkami). Prázdné = všechny registrované.
ADMIN_PROJECTS=demo-web,sandbox,ponycedecka,ponici

# Zapnuté core moduly (čárkami). Výchozí: všechny.
# ADMIN_MODULES=dashboard,content,media,audit,settings

# TTL session v ms (výchozí 7 dní).
# ADMIN_SESSION_TTL_MS=604800000

# Kořen adresáře s daty projektů: <root>/<projectId>/manifest.json, store/, audit/, media/
# Výchozí: <workspace>/content/projects
ADMIN_PROJECTS_ROOT=

# Volitelné deploy webhooky per projekt (JSON): {"demo-web": "https://…"}
# Volá se POST po každém publishi daného projektu.
ADMIN_PROJECT_HOOK_URLS=

# Obnova hesla e-mailem (kód). E-maily, které smějí žádat (čárkami).
# Bez ADMIN_RESET_EMAILS je funkce vypnutá. Další se přidají za přihlášení.
ADMIN_RESET_EMAILS=monika.zamrazilova@seznam.cz
# Formspree ID formuláře, na který se posílá kód (MOCK dokud je prázdné).
ADMIN_FORMSPREE_ID=
# TTL kódu (ms) a max. počet špatných pokusů (volitelné).
# ADMIN_RESET_CODE_TTL_MS=900000
# ADMIN_RESET_MAX_ATTEMPTS=5

# URL webu pro položku „Vstup do edit web“ (single-origin = /, jinak plná URL)
ADMIN_WEB_URL=
